@@ -1177,10 +1177,8 @@ adc at 1f {
 			};
 
 			pwm at 20{
-				compatible = "max31790";
+				compatible = "maxim,max31790";
 				reg = <0x20>;
-				#address-cells = <1>;
-				#size-cells = <0>;
 			};
 
 			gpio at 22{
@@ -1191,10 +1189,8 @@ gpio at 22{
 			};
 
 			pwm at 23{
